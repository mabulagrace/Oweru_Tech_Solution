# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values.
# `.env` holds secrets and must NEVER be committed or shared.
# Anything already set as a real environment variable overrides this file.
# ---------------------------------------------------------------------------

# --- Outgoing email (SMTP) -------------------------------------------------
# Until SMTP_HOST is set, emails are only printed to the server console and
# customers do NOT receive them.
# Run `python manage.py send_test_email` after filling this in to confirm.

# Gmail:      smtp.gmail.com          port 587
# Outlook:    smtp.office365.com     port 587
# cPanel:     mail.yourdomain.com    port 465 (set SMTP_USE_TLS=false)
#             or port 587 with SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true

# For Gmail, create an App Password (not your normal password) at
# https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASSWORD=

# The "from" address customers see. Must be one your provider allows.
SMTP_FROM=Oweru Tech Solutions <hello@oweru.tech>

# Where admin notifications and reminders go.
SMTP_NOTIFY_TO=hello@oweru.tech

# --- Site -------------------------------------------------------------------
# Your real domain. Used to build links inside emails.
SITE_URL=http://127.0.0.1:8000

# --- Security ---------------------------------------------------------------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Leave it unset for local development: a throwaway development key is used
# automatically. Never reuse this value in production, and never commit .env.
DJANGO_SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Nothing here needs to be set for the original local PostgreSQL setup. The
# built-in defaults are oweru_tech / postgres / localhost:5432 - set your own
# values below only if your machine differs.
#
# Zero-setup development database, no PostgreSQL server required:
# DB_ENGINE=sqlite
#
# DB_ENGINE=postgresql
# DB_NAME=oweru_tech
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432
#
# Or one connection string, which takes priority over the DB_* values above:
# DATABASE_URL=postgres://user:password@host:5432/dbname
